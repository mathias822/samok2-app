# Kopier denne filen til en ny fil som heter ".env" (uten ".example") og fyll inn nøkkelen din.
# .env-filen skal ALDRI deles eller lastes opp til GitHub.

# Din API-nøkkel fra https://console.anthropic.com (starter med sk-ant-)
ANTHROPIC_API_KEY=

# Hvilken Claude-modell appen bruker:
#   claude-sonnet-5-5  – god kvalitet, rimelig (anbefalt)
#   claude-opus-5-5    – best kvalitet, omtrent dobbelt så dyr
#   claude-haiku-5-5   – billigst, enklere svar
CLAUDE_MODELL=claude-sonnet-5-5

# Hvor grundig Claude skal tenke: low, medium eller high (high = bedre, men tregere og dyrere)
CLAUDE_INNSATS=medium

# Sett til 1 for å prøve appen med eksempelsvar uten å bruke API-et
DEMO=0

# Porten appen kjører på (adressen blir http://localhost:3000)
PORT=3000
